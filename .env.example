# US61: variabili d'ambiente per docker-compose.
# Copia questo file in ".env" e personalizza i valori prima di "docker compose up".

# Segreto per la firma dei token JWT (in produzione usa un valore lungo e casuale)
JWT_SECRET=dev-secret-change-me

# Origine consentita per le richieste CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# URL base delle API usato dal frontend in fase di build (Vite)
VITE_API_URL=http://localhost:3001/api/v1
