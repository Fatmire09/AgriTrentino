                    "colturaId": "664a1b2c3d4e5f6a7b8c9d10",
                    "tipologia": "Vite",
                    "varieta": "Chardonnay",
                    "faseCorrente": "fioritura",
                    "dataInizioFase": "2026-05-15T00:00:00.000Z",
                    "gddAccumulati": 87.5,
                    "fasePossibileSuccessiva": "allegagione",
                    "sogliaGddProssima": 200,
                    "percentualeProgresso": 44,
                    "tBaseC": 10,
                    "ultimoCalcolo": "2026-05-23T01:00:15.000Z"
                }
            }
+ Response 200 (application/json)
    Nessuna fenologia disponibile (campo senza coltura).
    + Body
            {
                "fenologia": null,
                "message": "Nessuna coltura associata a questo appezzamento"
            }
+ Response 200 (application/json)
    Coltura presente ma senza fase fenologica impostata.
    + Body
            {
                "fenologia": null,
                "message": "La coltura non ha una fase fenologica impostata"
            }
+ Response 401 (application/json)
    + Body
            { "error": "Token mancante" }
+ Response 403 (application/json)
    + Body
            { "error": "Non autorizzato" }
+ Response 404 (application/json)
    + Body
