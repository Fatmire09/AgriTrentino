    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
